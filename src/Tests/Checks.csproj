<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(SPTBinaries)' == ''">
    <PackageReference Include="HarmonyX" Version="2.16.1" />
    <ProjectReference Include="$(SPTSource)/Libraries/SPTushonka.Server.Core/SPTushonka.Server.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../RaidRoulette/**/*.cs" Exclude="../RaidRoulette/bin/**;../RaidRoulette/obj/**" />
  </ItemGroup>
  <ItemGroup Condition="'$(SPTBinaries)' != ''">
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SPTBinaries)/SPTarkov.Common.dll</HintPath>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SPTBinaries)/SPTarkov.DI.dll</HintPath>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SPTBinaries)/SPTarkov.Server.Core.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SPTBinaries)/0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SPTBinaries)/SemanticVersioning.dll</HintPath>
    </Reference>
    <Reference Include="FastCloner">
      <HintPath>$(SPTBinaries)/FastCloner.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/TrailItems.cs" Link="Shared/TrailItems.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(RaidRouletteTasksSource)/src/Shared/QuestIds.cs" Link="Shared/QuestIds.cs" />
    <EmbeddedResource Include="$(RaidRouletteTasksSource)/src/QuestPackServer/Quests/quests.json" LogicalName="RaidRoulette.Quests.quests.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/CloneTagIdentity.cs" Link="Shared/CloneTagIdentity.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(RaidRouletteTasksSource)/src/QuestPackServer/**/*.cs" Exclude="$(RaidRouletteTasksSource)/src/QuestPackServer/bin/**;$(RaidRouletteTasksSource)/src/QuestPackServer/obj/**;$(RaidRouletteTasksSource)/src/QuestPackServer/QuestPackMod.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/RaidChances.cs" Link="Shared/RaidChances.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Client/LockedLootBackpackPolicy.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/GuardedPolicy.cs" Link="Shared/GuardedPolicy.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/GauntletPolicy.cs" Link="Shared/GauntletPolicy.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/DoorTeleportPolicy.cs" Link="Shared/DoorTeleportPolicy.cs" />
  </ItemGroup>
</Project>
