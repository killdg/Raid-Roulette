<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Authors>killdg</Authors>
    <AssemblyName>RaidRoulette.LanguagePack</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../Shared/CatalogStore.cs" Link="Shared/CatalogStore.cs" />
    <Reference Include="SPTarkov.Common"><HintPath>$(SPTBinaries)/SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(SPTBinaries)/SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SPTBinaries)/SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(SPTBinaries)/SemanticVersioning.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SPTBinaries)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
